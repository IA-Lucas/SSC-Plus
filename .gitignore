# Segredos e estado local — nunca entram no Git
.env
*.secret.json
*.key
*.pem
secrets/
*.local.json

# Chave de selo local do laboratorio (HMAC) — runtime, nunca versionada
chave_selo.bin

# Logs brutos e temporarios
logs/*.tmp
*.log
*.tmp
*.trace

# Runtime / caches
__pycache__/
*.pyc
node_modules/
.venv/

# Cobertura e traces de medicao
.coverage
coverage.xml
htmlcov/
.tracecov/
.cover/

# Runtime da P0: laboratorios das corridas e dos testes.
# Dentro de labs/ ficam CAS (cas/), sessoes (sessoes/), EventLogs (logs/*.jsonl),
# checkpoints (checkpoints/) e chave_selo.bin — tudo estado de execucao.
# Os relatorios agregados sem segredo (05_p0/saidas/*.json) PERMANECEM versionados.
05_p0/saidas/labs/

# Runtime da P2 (mesma natureza): cada corrida do runner monta um lab
# proprio sob 08_p2/saidas/labs/. As EVIDENCIAS da corrida
# (08_p2/evidencias/*.json) sao agregadas, redigidas e PERMANECEM
# versionadas — e o lab, que carrega saida crua de modelo, que nao sobe.
08_p2/saidas/

# Estado do escritor unico (P1-A.1): locks, leases e fencing tokens —
# runtime puro, nunca versionado.
locks/

# EventLogs brutos (JSONL) onde quer que aparecam como runtime
*.jsonl

# Registro de mutante ativo da reversao vermelha (CLAUDE.md): estado de
# instrumento, como locks/. O README do diretorio E versionado, porque a
# convencao precisa sobreviver a limpeza.
scratchpad/MUTANTE-ATIVO.txt

# Sistema operacional
Thumbs.db
Desktop.ini
